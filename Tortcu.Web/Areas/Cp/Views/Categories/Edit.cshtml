@model Tortcu.Domain.Category
@{
    ViewData["Title"] = "Kateqoriya redaktəsi";
    var error = ViewData["Error"] as string;
}
<div class="card pad is-visible" style="max-width: 480px;">
    <h1>Kateqoriya redaktəsi</h1>
    @if (!string.IsNullOrEmpty(error))
    {
        <p style="color: var(--accent); margin: 8px 0;">@error</p>
    }
    <form method="post" asp-action="Edit" asp-route-id="@Model.Id" style="margin-top: 16px;">
        @Html.AntiForgeryToken()
        <div style="margin-bottom: 12px;">
            <label for="name" style="display:block; margin-bottom: 4px;">Ad</label>
            <input type="text" id="name" name="name" value="@Model.Name" required style="width:100%; padding: 10px; border-radius: 8px; border: 1px solid var(--line);" />
        </div>
        <div style="margin-bottom: 12px;">
            <label for="slug" style="display:block; margin-bottom: 4px;">Slug</label>
            <input type="text" id="slug" name="slug" value="@Model.Slug" style="width:100%; padding: 10px; border-radius: 8px; border: 1px solid var(--line);" />
        </div>
        <div style="margin-bottom: 12px;">
            <label for="displayOrder" style="display:block; margin-bottom: 4px;">Sıra nömrəsi</label>
            <input type="number" id="displayOrder" name="displayOrder" value="@Model.DisplayOrder" style="width:100%; padding: 10px; border-radius: 8px; border: 1px solid var(--line);" />
        </div>
        <div style="margin-bottom: 16px;">
            <label style="display:flex; align-items:center; gap: 8px;">
                <input type="checkbox" name="isActive" value="true" @(Model.IsActive ? "checked" : "") />
                Aktiv
            </label>
        </div>
        <div style="display:flex; gap: 10px;">
            <button type="submit" class="btn primary">Yadda saxla</button>
            <a asp-action="Index" class="btn ghost">Geri</a>
        </div>
    </form>
</div>
