@model IEnumerable<Tortcu.Web.Areas.Cp.Models.CategoryListModel>
@{
    ViewData["Title"] = "Kateqoriyalar";
    var error = TempData["Error"] as string;
    var success = TempData["Success"] as string;
}
<div class="card pad is-visible">
    <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:12px;">
        <h1 style="margin:0;">Kateqoriyalar</h1>
        <a asp-action="Create" class="btn primary">Yeni kateqoriya</a>
    </div>
    @if (!string.IsNullOrEmpty(error))
    {
        <p style="color: var(--accent); margin: 12px 0 0;">@error</p>
    }
    @if (!string.IsNullOrEmpty(success))
    {
        <p style="color: #2e7d32; margin: 12px 0 0;">@success</p>
    }
    @if (!Model.Any())
    {
        <p style="color: var(--muted); margin-top: 18px;">Hələ kateqoriya yoxdur. <a asp-action="Create">Birinci kateqoriya əlavə edin</a>.</p>
    }
    else
    {
        <table style="width:100%; margin-top: 18px; border-collapse: collapse;">
            <thead>
                <tr style="border-bottom: 1px solid var(--line); text-align:left;">
                    <th style="padding: 10px 8px;">Ad</th>
                    <th style="padding: 10px 8px;">Slug</th>
                    <th style="padding: 10px 8px;">Sıra</th>
                    <th style="padding: 10px 8px;">Məhsul</th>
                    <th style="padding: 10px 8px;">Status</th>
                    <th style="padding: 10px 8px;"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model)
                {
                    <tr style="border-bottom: 1px solid var(--line);">
                        <td style="padding: 10px 8px;">@c.Name</td>
                        <td style="padding: 10px 8px; color: var(--muted); font-size: 13px;">@c.Slug</td>
                        <td style="padding: 10px 8px;">@c.DisplayOrder</td>
                        <td style="padding: 10px 8px;">@c.ProductCount</td>
                        <td style="padding: 10px 8px;">@(c.IsActive ? "Aktiv" : "Passiv")</td>
                        <td style="padding: 10px 8px;">
                            <a asp-action="Edit" asp-route-id="@c.Id" class="btn">Redaktə</a>
                            <form asp-action="Delete" asp-route-id="@c.Id" method="post" style="display:inline;" onsubmit="return confirm('Kateqoriyanı silmək istədiyinizə əminsiniz?');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn ghost" style="color: var(--accent);">Sil</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
