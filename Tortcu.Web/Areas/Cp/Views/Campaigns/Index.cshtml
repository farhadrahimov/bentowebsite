@model IEnumerable<Tortcu.Domain.Campaign>
@{
    ViewData["Title"] = "Kampaniyalar";
    var success = TempData["Success"] as string;
}
<div class="card pad is-visible">
    <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:12px;">
        <h1 style="margin:0;">Kampaniyalar</h1>
        <a asp-action="Create" class="btn primary">Yeni kampaniya</a>
    </div>
    @if (!string.IsNullOrEmpty(success))
    {
        <p style="color: #2e7d32; margin: 12px 0 0;">@success</p>
    }
    @if (!Model.Any())
    {
        <p style="color: var(--muted); margin-top: 18px;">Kampaniya yoxdur. Ana səhifədə banner göstərmək üçün kampaniya əlavə edin.</p>
    }
    else
    {
        <table style="width:100%; margin-top: 18px; border-collapse: collapse;">
            <thead>
                <tr style="border-bottom: 1px solid var(--line); text-align:left;">
                    <th style="padding: 10px 8px;">Başlıq</th>
                    <th style="padding: 10px 8px;">Alt başlıq</th>
                    <th style="padding: 10px 8px;">Status</th>
                    <th style="padding: 10px 8px;"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model)
                {
                    <tr style="border-bottom: 1px solid var(--line);">
                        <td style="padding: 10px 8px;">@c.Title</td>
                        <td style="padding: 10px 8px; color: var(--muted); max-width: 200px;">@(c.SubTitle ?? "—")</td>
                        <td style="padding: 10px 8px;">@(c.IsActive ? "Aktiv" : "Passiv")</td>
                        <td style="padding: 10px 8px;">
                            <a asp-action="Edit" asp-route-id="@c.Id" class="btn">Redaktə</a>
                            <form asp-action="Delete" asp-route-id="@c.Id" method="post" style="display:inline;" onsubmit="return confirm('Silmək istədiyinizə əminsiniz?');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn ghost" style="color: var(--accent);">Sil</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
