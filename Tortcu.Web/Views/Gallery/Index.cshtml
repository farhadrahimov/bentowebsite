@model List<string>
<section class="section">
    <div class="container">
        <div class="card pad is-visible">
            <h1>Qalereya</h1>
            <p style="margin:0; color: var(--muted);">
                @if (Model.Count == 0)
                {
                    <span>Qalereyada şəkil yoxdur. Admin paneldə məhsul redaktə edərkən "Qalereyada göstər" seçin.</span>
                }
                else
                {
                    <span>@Model.Count şəkil — məhsullardan seçilmiş görüntülər.</span>
                }
            </p>
        </div>

        @if (Model.Count > 0)
        {
            <div style="height:14px;"></div>
            <div class="grid gallery-grid">
                @foreach (var src in Model)
                {
                    <div class="gallery-item" data-lightbox-src="@src">
                        <img src="@src" alt="" loading="lazy" />
                    </div>
                }
            </div>
        }
    </div>
</section>

