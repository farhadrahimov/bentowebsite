@model Tortcu.Web.ViewModels.ProductDetailViewModel

<section class="section">
    <div class="container">
        <div class="card pad">
            <h1>@Model.Name</h1>
            <p style="margin:0; color: var(--muted);">
                @(Model.CategoryName ?? "Kateqoriya")
            </p>
        </div>

        <div style="height:14px;"></div>

        <div class="two-col">
            <div class="card detail-media-card">
                @{
                    var primaryImg = Model.Images.FirstOrDefault(x => x.IsPrimary)?.Url
                                  ?? Model.Images.FirstOrDefault()?.Url;
                    var extraImgs = Model.Images
                        .Where(x => x.Url != primaryImg && !string.IsNullOrWhiteSpace(x.Url))
                        .Take(4)
                        .ToList();
                }
                @if (!string.IsNullOrWhiteSpace(primaryImg))
                {
                    <div class="detail-main-img" data-lightbox-src="@primaryImg" style="cursor:zoom-in;" title="Böyütmək üçün klikləyin">
                        <img src="@primaryImg" alt="@Model.Name" loading="eager" data-main />
                    </div>
                }
                else
                {
                    <div class="detail-main-img">
                        <div class="noimg" style="height:100%; display:grid; place-items:center; font-size:56px; font-family:'Playfair Display',serif; color:var(--brand);">
                            @(Model.Name.Length > 0 ? Model.Name[0].ToString() : "T")
                        </div>
                    </div>
                }
                @if (extraImgs.Count > 0)
                {
                    <div class="detail-extra-imgs">
                        @foreach (var img in extraImgs)
                        {
                            <div class="detail-extra-thumb" data-lightbox-src="@img.Url"
                                 onclick="var m=document.querySelector('img[data-main]'); if(m) m.src='@img.Url'">
                                <img src="@img.Url" alt="@Model.Name" loading="lazy" />
                            </div>
                        }
                    </div>
                }
            </div>

            <div class="card pad">
                <div class="pill">tort • cake • bento</div>
                <div style="height: 10px;"></div>
                <div class="price" style="font-size: 26px;">₼ @Model.Price</div>
                <div style="height: 12px;"></div>
                <p style="margin:0; color: var(--muted); line-height: 1.7;">
                    @(string.IsNullOrWhiteSpace(Model.Description)
                        ? "Təsvir sonradan əlavə ediləcək. Məhsul vizual olaraq ön planda qalacaq şəkildə hazırlanıb."
                        : Model.Description)
                </p>
                <div style="height: 16px;"></div>
                <a class="btn primary" href="/contact">
                    Sifariş üçün əlaqə
                </a>
                <a class="btn" href="/products" style="margin-left:10px;">Geri</a>
            </div>
        </div>
    </div>
</section>

@section Schema {
    <script type="application/ld+json">
        {
          "@@context": "https://schema.org",
          "@@type": "Product",
          "name": "@Model.Name",
          "description": "@(Model.Description ?? "")",
          "offers": {
            "@@type": "Offer",
            "priceCurrency": "AZN",
            "price": "@Model.Price",
            "availability": "https://schema.org/PreOrder"
          }
        }
    </script>
}

