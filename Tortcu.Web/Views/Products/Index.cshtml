@model Tortcu.Web.ViewModels.ProductsIndexViewModel

<section class="section">
    <div class="container">
        <div class="card pad">
            <h1>@(Model.CategoryName ?? "Məhsullar")</h1>
        </div>

        <div style="height: 14px;"></div>

        <div class="card pad">
            <div class="filters" aria-label="Category filters">
                <a class="chip @(string.IsNullOrWhiteSpace(Model.CategorySlug) ? "active" : "")" href="/products">Hamısı</a>
                @foreach (var c in Model.Categories)
                {
                    <a class="chip @(Model.CategorySlug == c.Slug ? "active" : "")" href="/products/@c.Slug">@c.Name</a>
                }
            </div>
        </div>

        <div style="height: 14px;"></div>

        <div class="grid">
            @if (Model.Products.Count == 0)
            {
                <div class="grid-empty">
                    <p>Bu kateqoriyada hələ məhsul yoxdur.</p>
                    <a href="/products" class="btn">Bütün məhsullara bax</a>
                </div>
            }
            else
            {
                foreach (var p in Model.Products)
                {
                    <a class="card product" href="/products/@p.Slug">
                        <div class="thumb">
                            @if (!string.IsNullOrWhiteSpace(p.ThumbnailUrl))
                            {
                                <img src="@p.ThumbnailUrl" alt="@p.Name" loading="lazy" />
                            }
                            else
                            {
                                <div class="noimg"><span>@(p.Name.Length > 0 ? p.Name[0].ToString() : "T")</span></div>
                            }
                        </div>
                        <strong>@p.Name</strong>
                        @if (!string.IsNullOrEmpty(p.CategoryName))
                        {
                            <small>@p.CategoryName</small>
                        }
                        <div style="display:flex; justify-content:space-between; align-items:center; margin-top:auto;">
                            <span class="price">@p.Price.ToString("N2") ₼</span>
                            <span class="chip" style="font-size: 11px; padding: 4px 10px;">Sifariş et</span>
                        </div>
                    </a>
                }
            }
        </div>
    </div>
</section>

