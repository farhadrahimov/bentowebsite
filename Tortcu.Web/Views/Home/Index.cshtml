@model Tortcu.Web.ViewModels.HomeViewModel

<section class="hero">
    <div class="container">
        <div class="hero-band card">
            <div class="hero-band__text">
                <h1>Premium tortlar,<br>sevgi ilə hazırlanır.</h1>
                <p>Bakıda ev şəraitində hazırlanan tort və şirniyyatlar. Hər sifariş fərdi hazırlanır.</p>
                <div class="hero-actions">
                    <a class="btn primary" href="/products">Məhsullara bax</a>
                    <a class="btn" href="/order">Online sifariş</a>
                </div>
            </div>
            <div class="hero-band__media">
                @if (!string.IsNullOrEmpty(Model.Campaign?.ImageUrl))
                {
                    <div class="hero-campaign">
                        <img src="@Model.Campaign.ImageUrl" alt="@(Model.Campaign.Title)" loading="eager" />
                        <div class="hero-campaign__label">
                            <strong>@Model.Campaign.Title</strong>
                            @if (!string.IsNullOrEmpty(Model.Campaign.SubTitle))
                            {
                                <span>@Model.Campaign.SubTitle</span>
                            }
                        </div>
                    </div>
                }
                else if (Model.Campaign != null)
                {
                    <div class="hero-campaign hero-campaign--text">
                        <div class="hero-campaign__label">
                            <strong>@Model.Campaign.Title</strong>
                            @if (!string.IsNullOrEmpty(Model.Campaign.SubTitle))
                            {
                                <span>@Model.Campaign.SubTitle</span>
                            }
                        </div>
                    </div>
                }
                else
                {
                    <div class="hero-campaign hero-campaign--empty">
                        <div style="font-size: 48px; line-height: 1;">🎂</div>
                        <div style="color: var(--muted); font-size: 14px; margin-top: 8px;">Yeni tortlarımız hazırlanır</div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@if (Model.Categories.Count > 0)
{
    <section class="section section--cats">
        <div class="container">
            <div class="cats-row">
                @foreach (var c in Model.Categories)
                {
                    <a class="cat-pill" href="/products/@c.Slug">@c.Name</a>
                }
                <a class="cat-pill cat-pill--all" href="/products">Bütün məhsullar →</a>
            </div>
        </div>
    </section>
}

<section class="section">
    <div class="container">
        <div class="section-head">
            <div>
                <h2>Populyar məhsullar</h2>
            </div>
            <a class="chip" href="/products">Hamısı</a>
        </div>

        <div class="grid">
            @if (Model.PopularProducts.Count == 0)
            {
                <div class="grid-empty">
                    <p>Hələ populyar məhsul əlavə olunmayıb. Admin paneldə məhsullara "Populyar" işarəsi qoyun.</p>
                    <a href="/products" class="btn">Bütün məhsullara bax</a>
                </div>
            }
            else
            {
                foreach (var p in Model.PopularProducts)
                {
                    <a class="card product" href="/products/@p.Slug">
                        <div class="thumb">
                            @if (!string.IsNullOrWhiteSpace(p.ThumbnailUrl))
                            {
                                <img src="@p.ThumbnailUrl" alt="@p.Name" loading="lazy" />
                            }
                            else
                            {
                                <div class="noimg">
                                    <span>@p.Name[0]</span>
                                </div>
                            }
                        </div>
                        <strong>@p.Name</strong>
                        <small>@(p.CategoryName ?? "")</small>
                        <div style="display:flex; justify-content:space-between; align-items:center; margin-top: auto;">
                            <span class="price">@p.Price.ToString("N2") ₼</span>
                            <span class="chip" style="font-size: 11px; padding: 4px 10px;">Sifariş et</span>
                        </div>
                    </a>
                }
            }
        </div>
    </div>
</section>

@section Schema {
    <script type="application/ld+json">
        {
          "@@context": "https://schema.org",
          "@@type": "Bakery",
          "name": "Tortcu",
          "url": "@(ViewData["CanonicalUrl"] ?? "")",
          "telephone": "+994505761417",
          "email": "Tortcu@@bk.ru",
          "address": {
            "@@type": "PostalAddress",
            "addressLocality": "Bakı",
            "addressCountry": "AZ"
          },
          "servesCuisine": "Şirniyyat, Tort",
          "priceRange": "₼₼",
          "sameAs": [
            "https://www.instagram.com/tortcu.baku",
            "https://wa.me/994505761417"
          ]
        }
    </script>
}

