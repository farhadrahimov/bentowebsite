@{
    var aboutImg = ViewData["AboutMainImageUrl"] as string;
    var aboutText = (ViewData["AboutText"] as string) ?? "";
    var hasImage = !string.IsNullOrWhiteSpace(aboutImg);
}
<section class="section">
    <div class="container">
        <div class="about-header card pad">
            <h1>Haqqımızda</h1>
        </div>

        <div style="height:14px;"></div>

        @if (hasImage)
        {
            <div class="about-with-img">
                <div class="about-with-img__img card">
                    <img src="@aboutImg" alt="Tortcu haqqında" loading="lazy" />
                </div>
                <div class="card pad about-with-img__text">
                    <div class="about-text">@Html.Raw(aboutText.Replace("\n", "<br/>"))</div>
                </div>
            </div>
        }
        else
        {
            <div class="card pad">
                <div class="about-text">@Html.Raw(aboutText.Replace("\n", "<br/>"))</div>
            </div>
        }
    </div>
</section>

